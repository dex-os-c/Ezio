# ============================================================
# Ezio FastAPI Dockerfile with Playwright (opt-in)
# Use: docker build -f Dockerfile.fastapi.playwright -t ezio:playwright .
# ============================================================

ARG GPU=false
ARG OTX_API_KEY=""
ARG ABUSECH_API_KEY=""

FROM python:3.11-slim AS builder

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY api/ api/
COPY analysis/ analysis/
COPY auth/ auth/
COPY crawler/ crawler/
COPY db/ db/
COPY export/ export/
COPY extractor/ extractor/
COPY fingerprint/ fingerprint/
COPY graph/ graph/
COPY i18n/ i18n/
COPY monitor/ monitor/
COPY scraper/ scraper/
COPY search/ search/
COPY sources/ sources/
COPY utils/ utils/
COPY ezio/ ezio/
COPY ezio_cli/ ezio_cli/
COPY config.py .

RUN --mount=type=cache,target=/root/.pip \
    if [ "$GPU" = "true" ]; then \
        pip install --no-cache-dir .; \
    else \
        pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
        pip install --no-cache-dir .; \
    fi

RUN --mount=type=cache,target=/root/.pip \
    pip install --no-cache-dir playwright && \
    playwright install chromium && \
    playwright install-deps chromium

COPY scripts/ scripts/

RUN --mount=type=cache,target=/root/.pip \
    if [ -n "$OTX_API_KEY" ] || [ -n "$ABUSECH_API_KEY" ]; then \
        OTX_API_KEY=$OTX_API_KEY ABUSECH_API_KEY=$ABUSECH_API_KEY \
        python scripts/download_seed.py || true; \
    fi


FROM python:3.11-slim

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    netcat-openbsd \
    curl \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 ezio && \
    useradd --uid 1000 --gid ezio --shell /bin/bash --create-home ezio

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --from=builder /app/data/seed_data.json.g[z] /data/seed_data.json.gz

RUN mkdir -p /data /app && chown -R ezio:ezio /app /data

COPY --chown=ezio:ezio . .

RUN python -c "import spacy; spacy.load('en_core_web_sm')" 2>/dev/null || \
    python -m spacy download en_core_web_sm

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV TF_ENABLE_ONEDNN_OPTS=0
ENV TF_CPP_MIN_LOG_LEVEL=3
ENV DATABASE_URL=postgresql://ezio:ezio@postgres:5432/ezio
ENV TOR_PROXY_HOST=tor
ENV TOR_PROXY_PORT=9050
ENV PLAYWRIGHT_ENABLED=true

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

RUN chmod +x /app/docker/*.sh && chmod +x /app/*.sh 2>/dev/null || true

USER ezio

ENTRYPOINT ["/app/docker/docker-entrypoint.sh"]
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
